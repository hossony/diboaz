---
import { SITE, NAV, SOCIAL, CONTACT } from '../site.config';
const year = new Date().getFullYear();
const wa = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(CONTACT.whatsappMessage)}`;
---
<footer class="site-footer">
  <div class="brand">{SITE.name}</div>
  <div><em>{SITE.tagline}</em> · Oficina em {SITE.city}–{SITE.state}, Brasil</div>
  <nav aria-label="Rodapé">
    {NAV.map((i) => <a href={i.href}>{i.label}</a>)}
    {SOCIAL.instagram && <a href={SOCIAL.instagram} rel="me noopener" target="_blank">Instagram</a>}
    {SOCIAL.youtube && <a href={SOCIAL.youtube} rel="me noopener" target="_blank">YouTube</a>}
    {SOCIAL.facebook && <a href={SOCIAL.facebook} rel="me noopener" target="_blank">Facebook</a>}
    <a href="/rss.xml">RSS</a>
  </nav>
  <div class="muted">© {year} {SITE.name} · {SITE.author}, luthier. Todos os direitos reservados.</div>
</footer>

<a class="wa-float" href={wa} target="_blank" rel="noopener" aria-label="Conversar pelo WhatsApp">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1-.8 1-1 1.2-.4.2-.7.1a8.2 8.2 0 0 1-4-3.5c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.8.4 3.6 3.6 0 0 0-1.1 2.6 6.2 6.2 0 0 0 1.3 3.3 14 14 0 0 0 5.4 4.8c2 .9 2.8 1 3.8.8a3.2 3.2 0 0 0 2.1-1.5 2.6 2.6 0 0 0 .2-1.5c-.1-.1-.3-.2-.6-.4ZM12 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8Zm0-21.6A11.8 11.8 0 0 0 1.8 17.9L.1 24l6.3-1.6A11.8 11.8 0 1 0 12 .2Z"/></svg>
</a>
