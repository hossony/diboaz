---
import { SITE } from '../site.config';
const { title, url } = Astro.props as { title: string; url: string };
const full = new URL(url, SITE.url).href;
const t = encodeURIComponent(title);
const u = encodeURIComponent(full);
---
<div class="share">
  <span>Compartilhar:</span>
  <a href={`https://wa.me/?text=${t}%20${u}`} target="_blank" rel="noopener">WhatsApp</a>
  <a href={`https://www.facebook.com/sharer/sharer.php?u=${u}`} target="_blank" rel="noopener">Facebook</a>
  <a href={`https://x.com/intent/post?text=${t}&url=${u}`} target="_blank" rel="noopener">X</a>
  <a href={`https://pinterest.com/pin/create/button/?url=${u}&description=${t}`} target="_blank" rel="noopener">Pinterest</a>
  <button type="button" data-copy={full}>Copiar link</button>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Link copiado ✓'; } catch { prompt('Copie o link:', b.dataset.copy); }
    })
  );
</script>
